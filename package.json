{
  "name": "typescript-test",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "bin": {
    "wt": "./src/cli.tsx"
  },
  "scripts": {
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "wt": "bun src/cli.tsx",
    "wt:dev": "bun --watch src/cli.tsx",
    "build": "bun build src/cli.tsx --outdir dist --entry-naming 'wt.[ext]' --target bun --minify --sourcemap --packages external",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "ci": "biome ci . && tsc --noEmit && bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/bun": "latest",
    "@types/react": "^19.2.17",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.2.8"
  }
}
